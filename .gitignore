# 原始数据保留在本地；说明、来源和校验清单进入版本管理。
/Datasets/**
!/Datasets/README.md
!/Datasets/manifest.json
!/Datasets/SHA256SUMS
!/Datasets/provenance.json

# 不继承旧实现、环境或编译缓存。
.venv/
.venv-*/
__pycache__/
.cache/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.nbc
*.nbi
*.o
.DS_Store

# 本研究的环境、派生产物和编辑器状态均留在项目内，但不提交大文件。
/.envs/
/.tools/
/artifacts/*
!/artifacts/README.md
/.vscode/
*.egg-info/
/build/
/dist/

# 小型、可复现的数据划分与校验清单进入版本管理。
!/Datasets/splits/
!/Datasets/splits/**
